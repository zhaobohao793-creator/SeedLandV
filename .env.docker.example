# =============================================================
# SeedLandV — 生产 Docker 部署环境变量
# 复制为 .env.docker 并填值，然后：
#   docker compose -f docker-compose.prod.yml --env-file .env.docker up -d --build
# .env.docker 含密钥，不要进 git（已在 .gitignore 忽略）。
# =============================================================

# --- Postgres（容器内自建库，账号密码自己定）-----------------
POSTGRES_USER=seedlandv
POSTGRES_PASSWORD=            # 必填：强随机密码，例如 openssl rand -hex 24
POSTGRES_DB=seedlandv

# --- 认证密钥 -----------------------------------------------
# 必填：openssl rand -hex 32
JWT_SECRET=
# 必填：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARK_KEY_FERNET_SECRET=

# --- 火山 TOS（对象存储，存放上传素材 + 产物镜像）------------
VOLC_TOS_AK=                  # 必填
VOLC_TOS_SK=                  # 必填
VOLC_TOS_BUCKET=              # 必填，例如 seedlandv-prod
VOLC_TOS_REGION=cn-beijing
VOLC_TOS_ENDPOINT=tos-cn-beijing.volces.com

# --- 可选（有默认值，一般不动）------------------------------
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_SUBMIT_RATE_LIMIT_PER_HOUR=100
# JWT_ACCESS_TTL_SECONDS=3600
# JWT_REFRESH_TTL_SECONDS=604800
# SENTRY_DSN=
# SENTRY_ENV=production

# 对外暴露的 API 端口（宿主机）。放反向代理后面时可改成只监听 127.0.0.1。
API_PORT=8000
